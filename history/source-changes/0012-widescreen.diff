+// bottom window, plus the strips left and right of them when the game area is wider than
+// the 800 pixel GUI.
+int gui_point_in_map(int x, int y)
+{
+	if (x < 0 || y < 0 || x >= XRES || y >= YRES) {
+		return 0;
+	}
+	if (x >= dotx(DOT_MTL) && x < dotx(DOT_MBR) && y >= doty(DOT_MTL) && y < doty(DOT_MBR)) {
+		return 1;
+	}
+	return x < gui_dx || x >= gui_dx + XRES0;
+}
