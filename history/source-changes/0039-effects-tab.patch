+	render_shaded_rect(sx, sy, sx + width + 8, sy + height + 8, 0x0000, 150);
+
+	sy += 4;
+	render_text_fmt(sx + 4, sy, 0xffff, 0, "%s: %s", ce->label, ce->value);
+	sy += 14;
+	if (ce->desc[0]) {
