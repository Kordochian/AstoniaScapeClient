diff -ruN pre2/src/gui/panels.c work/src/gui/panels.c
--- a/src/gui/panels.c	1970-01-01 00:00:00.000000000 +0000
+++ b/src/gui/panels.c	2026-10-12 17:29:25.507557548 +0000
@@ -0,0 +1,359 @@
+/*
+ * Part of Astonia Client (c) Daniel Brockhaus. Please read license.txt.
+ *
+ * Interface panels
+ *
+ * The top bar and the bottom window are cut into panels (level bars, equipment, menu,
+ * skills, status, chat, inventory). Each panel shows its piece of the original picture
+ * inside a frame like the Options window, and can be dragged by its title strip. Positions
+ * are saved in settings.ini, anchored to the nearest screen edge so they survive window
+ * size changes.
+ *
+ * Everything inside a panel is positioned by dots and buttons. init_dots() lays them out
+ * relative to the original pictures and then moves each one by its panel's offset
+ * (pnl_dx(), pnl_dy()).
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <SDL3/SDL.h>
+
+#include "astonia.h"
+#include "gui/gui.h"
+#include "gui/gui_private.h"
+#include "game/game.h"
+#include "client/client.h"
+#include "sdl/sdl.h"
+
+#define PANEL_PAD   3 // frame width left, right and below the picture
+#define PANEL_GAP   0 // space between panels in the default layout
+
+struct panel {
+	const char *key; // settings.ini name
+	const char *title;
+	int bottom; // 0: piece of the top bar picture, 1: of the bottom window picture
+	int bx, bw; // piece of the picture: columns bx .. bx+bw-1
+
+	int x, y; // frame top left in GUI pixels
+	int saved; // position comes from the settings / a drag, not the default layout
+	int ax, ox, ay, oy; // saved position: anchor (0 left/top, 1 center, 2 right/bottom) and offset
+};
+
+static struct panel panel[MAX_PANEL] = {
+    {"level", "Level", 0, 0, 156},
+    {"equipment", "Equipment", 0, 156, 484},
+    {"menu", "Menu", 0, 640, 160},
+    {"skills", "Skills", 1, 0, 174},
+    {"status", "Status", 1, 174, 47},
+    {"chat", "Chat", 1, 221, 403},
+    {"inventory", "Inventory", 1, 624, 176},
+};
+
+int panels_locked = 0;
+
+static int drag = -1, drag_dx, drag_dy;
+
+static int top_h(void)
+{
+	return 40;
+}
+
+static int bot_h(void)
+{
+	return (game_options & GO_SMALLBOT) ? 130 : 170;
+}
+
+// height of the picture piece
+static int piece_h(int p)
+{
+	return panel[p].bottom ? bot_h() : top_h();
+}
+
+int pnl_w(int p)
+{
+	return panel[p].bw + PANEL_PAD * 2;
+}
+
+int pnl_h(int p)
+{
+	return piece_h(p) + PANEL_TITLE + PANEL_PAD;
+}
+
+int pnl_x(int p)
+{
+	return panel[p].x;
+}
+
+int pnl_y(int p)
+{
+	return panel[p].y;
+}
+
+// Offset from the original picture coordinates (picture top left at 0,0) to the screen
+int pnl_dx(int p)
+{
+	return panel[p].x + PANEL_PAD - panel[p].bx;
+}
+
+int pnl_dy(int p)
+{
+	return panel[p].y + PANEL_TITLE;
+}
+
+// Height of the default top row and the top of the default bottom row
+int panels_top_row_h(void)
+{
+	return top_h() + PANEL_TITLE + PANEL_PAD;
+}
+
+int panels_bottom_row_y(void)
+{
+	return YRES - (bot_h() + PANEL_TITLE + PANEL_PAD);
+}
+
+static int clampi(int v, int lo, int hi)
+{
+	if (v > hi) {
+		v = hi;
+	}
+	if (v < lo) {
+		v = lo;
+	}
+	return v;
+}
+
+// Default layout: the pieces side by side as in the original bars, centered
+static void default_pos(int p, int *px, int *py)
+{
+	int i, w = 0, x;
+
+	for (i = 0; i < MAX_PANEL; i++) {
+		if (panel[i].bottom == panel[p].bottom) {
+			w += pnl_w(i) + PANEL_GAP;
+		}
+	}
+	w -= PANEL_GAP;
+
+	x = (XRES - w) / 2;
+	for (i = 0; i < p; i++) {
+		if (panel[i].bottom == panel[p].bottom) {
+			x += pnl_w(i) + PANEL_GAP;
+		}
+	}
+	*px = x;
+	*py = panel[p].bottom ? panels_bottom_row_y() : 0;
+}
+
+static int anchor_pos(int a, int o, int size, int screen)
+{
+	switch (a) {
+	case 0:
+		return o;
+	case 1:
+		return (screen - size) / 2 + o;
+	default:
+		return screen - size - o;
+	}
+}
+
+// Remember the current position, anchored to the edge (or center) nearest to the panel
+static void store_anchor(int p)
+{
+	int w = pnl_w(p), h = pnl_h(p);
+	int cx = panel[p].x + w / 2, cy = panel[p].y + h / 2;
+
+	panel[p].ax = cx < XRES / 3 ? 0 : (cx < XRES * 2 / 3 ? 1 : 2);
+	panel[p].ay = cy < YRES / 3 ? 0 : (cy < YRES * 2 / 3 ? 1 : 2);
+	panel[p].ox = panel[p].ax == 0 ? panel[p].x : (panel[p].ax == 1 ? panel[p].x - (XRES - w) / 2 : XRES - w - panel[p].x);
+	panel[p].oy = panel[p].ay == 0 ? panel[p].y : (panel[p].ay == 1 ? panel[p].y - (YRES - h) / 2 : YRES - h - panel[p].y);
+	panel[p].saved = 1;
+}
+
+// Work out all panel positions for the current game area size. Called by init_dots().
+void panels_layout(void)
+{
+	int p;
+
+	for (p = 0; p < MAX_PANEL; p++) {
+		if (p == drag) {
+			continue; // being dragged: keep where the mouse put it
+		}
+		if (panel[p].saved) {
+			panel[p].x = anchor_pos(panel[p].ax, panel[p].ox, pnl_w(p), XRES);
+			panel[p].y = anchor_pos(panel[p].ay, panel[p].oy, pnl_h(p), YRES);
+		} else {
+			default_pos(p, &panel[p].x, &panel[p].y);
+		}
+		panel[p].x = clampi(panel[p].x, 0, XRES - pnl_w(p));
+		panel[p].y = clampi(panel[p].y, 0, YRES - pnl_h(p));
+	}
+}
+
+// Which panel is at this GUI position? -1 for none. Later panels are drawn on top.
+int pnl_at(int x, int y)
+{
+	int p;
+
+	for (p = MAX_PANEL - 1; p >= 0; p--) {
+		if (x >= panel[p].x && x < panel[p].x + pnl_w(p) && y >= panel[p].y && y < panel[p].y + pnl_h(p)) {
+			return p;
+		}
+	}
+	return -1;
+}
+
+static int on_title(int p, int x, int y)
+{
+	return x >= panel[p].x && x < panel[p].x + pnl_w(p) && y >= panel[p].y && y < panel[p].y + PANEL_TITLE;
+}
+
+// Panels moved: lay out the dots and buttons again (the map stays where it is)
+static void panels_moved(void)
+{
+	// the help window can be dragged on its own; keep it where it is
+	DOT hlp = dot[DOT_HLP], hl2 = dot[DOT_HL2];
+	BUT hdrag = but[BUT_HELP_DRAG];
+
+	init_dots();
+	dot[DOT_HLP] = hlp;
+	dot[DOT_HL2] = hl2;
+	but[BUT_HELP_DRAG] = hdrag;
+	set_invoff(0, invoff);
+	set_skloff(0, skloff);
+	set_conoff(0, conoff);
+}
+
+// Put every panel back to the default layout
+void panels_reset(void)
+{
+	int p;
+
+	for (p = 0; p < MAX_PANEL; p++) {
+		panel[p].saved = 0;
+	}
+	drag = -1;
+	panels_moved();
+}
+
+// Mouse input for dragging panels by their title strip. Returns 1 if the event was used.
+int panels_mouse(int what, int x, int y)
+{
+	int p;
+
+	switch (what) {
+	case SDL_MOUM_NONE:
+		if (drag != -1) {
+			panel[drag].x = clampi(x - drag_dx, 0, XRES - pnl_w(drag));
+			panel[drag].y = clampi(y - drag_dy, 0, YRES - pnl_h(drag));
+			panels_moved();
+			return 1;
+		}
+		return 0;
+
+	case SDL_MOUM_LDOWN:
+		if (panels_locked || csprite) {
+			return 0;
+		}
+		p = pnl_at(x, y);
+		if (p == -1 || !on_title(p, x, y)) {
+			return 0;
+		}
+		drag = p;
+		drag_dx = x - panel[p].x;
+		drag_dy = y - panel[p].y;
+		return 1;
+
+	case SDL_MOUM_LUP:
+		if (drag == -1) {
+			return 0;
+		}
+		store_anchor(drag);
+		drag = -1;
+		panels_moved();
+		options_save();
+		return 1;
+
+	default:
+		return drag != -1;
+	}
+}
+
+int panels_dragging(void)
+{
+	return drag != -1;
+}
+
+// settings.ini: panel_<key>=ax,ox,ay,oy
+int panels_load_setting(const char *key, const char *val)
+{
+	int p, ax, ox, ay, oy;
+
+	if (strncmp(key, "panel_", 6)) {
+		return 0;
+	}
+	for (p = 0; p < MAX_PANEL; p++) {
+		if (!strcmp(key + 6, panel[p].key)) {
+			if (sscanf(val, "%d,%d,%d,%d", &ax, &ox, &ay, &oy) == 4) {
+				panel[p].ax = clampi(ax, 0, 2);
+				panel[p].ox = ox;
+				panel[p].ay = clampi(ay, 0, 2);
+				panel[p].oy = oy;
+				panel[p].saved = 1;
+			}
+			return 1;
+		}
+	}
+	return 0;
+}
+
+void panels_save_settings(void *vfp)
+{
+	FILE *fp = vfp;
+	int p;
+
+	fprintf(fp, "ui_locked=%d\n", panels_locked);
+	for (p = 0; p < MAX_PANEL; p++) {
+		if (panel[p].saved) {
+			fprintf(fp, "panel_%s=%d,%d,%d,%d\n", panel[p].key, panel[p].ax, panel[p].ox, panel[p].ay, panel[p].oy);
+		}
+	}
+}
+
+// Frames, title strips and the pieces of the original pictures. The panel contents
+// (items, skills, chat, ...) are drawn on top by the display_*() functions.
+void panels_display(void)
+{
+	int p, sx, sy, hov;
+	unsigned int spr;
+
+	hov = (!panels_locked && drag == -1) ? pnl_at(mousex, mousey) : -1;
+	if (hov != -1 && !on_title(hov, mousex, mousey)) {
+		hov = -1;
+	}
+
+	render_push_clip();
+	for (p = 0; p < MAX_PANEL; p++) {
+		render_set_clip(0, 0, XRES, YRES);
+		gui_draw_panel(panel[p].x, panel[p].y, pnl_w(p), pnl_h(p), PANEL_TITLE);
+		if (p == drag || p == hov) {
+			render_rect_alpha(panel[p].x + 2, panel[p].y + 1, panel[p].x + pnl_w(p) - 2, panel[p].y + PANEL_TITLE - 1,
+			    whitecolor, 24);
+		}
+		if (pnl_w(p) >= 60) {
+			render_text(panel[p].x + pnl_w(p) / 2, panel[p].y + 1, p == drag ? whitecolor : IRGB(31, 24, 10), RENDER_ALIGN_CENTER | RENDER_TEXT_SMALL,
+			    panel[p].title);
+		}
+
+		sx = panel[p].x + PANEL_PAD;
+		sy = panel[p].y + PANEL_TITLE;
+		if (panel[p].bottom) {
+			spr = opt_sprite((game_options & GO_SMALLBOT) ? 991 : 998);
+		} else {
+			spr = opt_sprite(999);
+		}
+		render_set_clip(sx, sy, sx + panel[p].bw, sy + piece_h(p));
+		render_sprite(spr, sx - panel[p].bx, sy, RENDERFX_NORMAL_LIGHT, RENDER_ALIGN_NORMAL);
+	}
+	render_pop_clip();
+}
