 CMakePresets.json                |  58 ++++++++++++
 build-msvc.bat                   |  62 +++++++++++++
 src/game/crash_handler_windows.c |  84 +++++++++++++++++
 vcpkg.json                       |  14 +++
 6 files changed, 375 insertions(+)
