diff --git a/build-msvc.bat b/build-msvc.bat
new file mode 100644
index 0000000..792861e
--- /dev/null
+++ b/build-msvc.bat
@@ -0,0 +1,62 @@
+@echo off
+rem Build the Astonia client natively on Windows with Visual Studio (clang-cl) + vcpkg.
+rem No MSYS2 needed. Run from anywhere; output goes to bin\moac.exe next to this file.
+rem
+rem   build-msvc.bat           Release build
+rem   build-msvc.bat debug     Debug build (DEVELOPER on)
+rem
+rem Needs: Visual Studio 2022 or 2026 with "Desktop development with C++",
+rem        "C++ Clang tools for Windows" and "vcpkg package manager";
+rem        Rust from https://rustup.rs ; git.
+
+setlocal
+cd /d "%~dp0"
+
+set PRESET=ninja
+if /i "%~1"=="debug" set PRESET=ninja-debug
+
+set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
+if not exist "%VSWHERE%" (
+    echo Visual Studio Installer not found. Install Visual Studio 2022 or 2026 first.
+    exit /b 1
+)
+for /f "usebackq delims=" %%i in (`"%VSWHERE%" -latest -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSINSTALL=%%i"
+if not defined VSINSTALL (
+    echo No Visual Studio with the C++ workload found. Add "Desktop development with C++".
+    exit /b 1
+)
+echo Using Visual Studio in %VSINSTALL%
+
+call "%VSINSTALL%\Common7\Tools\VsDevCmd.bat" -arch=amd64 -host_arch=amd64 -no_logo
+if errorlevel 1 exit /b 1
+
+if not exist "%VSINSTALL%\VC\Tools\Llvm\x64\bin\clang-cl.exe" (
+    echo clang-cl not found. In the Visual Studio Installer, add the component
+    echo "C++ Clang tools for Windows" ^(Individual components^).
+    exit /b 1
+)
+set "PATH=%VSINSTALL%\VC\Tools\Llvm\x64\bin;%PATH%"
+
+if not defined VCPKG_ROOT if exist "%VSINSTALL%\VC\vcpkg\vcpkg.exe" set "VCPKG_ROOT=%VSINSTALL%\VC\vcpkg"
+if not defined VCPKG_ROOT (
+    echo vcpkg not found. Add the "vcpkg package manager" component in the Visual Studio
+    echo Installer, or clone https://github.com/microsoft/vcpkg and set VCPKG_ROOT to it.
+    exit /b 1
+)
+
+where cargo >nul 2>nul || if exist "%USERPROFILE%\.cargo\bin\cargo.exe" set "PATH=%USERPROFILE%\.cargo\bin;%PATH%"
+where cargo >nul 2>nul || (
+    echo Rust not found. Install it from https://rustup.rs ^(default options^) and run this again.
+    exit /b 1
+)
+rustup target add x86_64-pc-windows-msvc >nul 2>nul
+
+cmake --preset %PRESET%
+if errorlevel 1 exit /b 1
+cmake --build --preset %PRESET%
+if errorlevel 1 exit /b 1
+
+echo.
+echo Done: %~dp0bin\moac.exe
+echo Copy res\ from the official v1.1.3 client next to bin\ before running it.
+endlocal
diff --git a/src/game/crash_handler_windows.c b/src/game/crash_handler_windows.c
index 297f352..0afc296 100644
--- a/src/game/crash_handler_windows.c
+++ b/src/game/crash_handler_windows.c
@@ -1,7 +1,17 @@
 #include <windows.h>
+#ifdef _MSC_VER
+#include <dbghelp.h>
+// Same line-number codes dwarfstack passes to errPrint()
+#define DWST_BASE_ADDR   -1
+#define DWST_NOT_FOUND   -2
+#define DWST_NO_DBG_SYM  -3
+#define DWST_NO_SRC_FILE -4
+#else
 #include <dwarfstack.h>
+#endif
 
 #include <stdio.h>
+#include <string.h>
 
 #include "astonia.h"
 #include "../sdl/sdl.h"
@@ -81,6 +91,76 @@ static void errPrint(uint64_t addr, const char *filename, int lineno, const char
 	}
 }
 
+#ifdef _MSC_VER
+// MSVC / clang-cl build: dwarfstack only reads DWARF (MinGW) debug info, so walk
+// the stack with DbgHelp instead. Function names and lines come from moac.pdb.
+static void dbghelp_print_stack(CONTEXT *ctx, int *count)
+{
+	HANDLE process = GetCurrentProcess();
+	HANDLE thread = GetCurrentThread();
+	CONTEXT c = *ctx;
+	STACKFRAME64 frame;
+	DWORD64 last_base = 0;
+	char modname[MAX_PATH];
+	union {
+		SYMBOL_INFO info;
+		char buf[sizeof(SYMBOL_INFO) + 256];
+	} sym;
+
+	SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES);
+	SymInitialize(process, NULL, TRUE);
+
+	memset(&frame, 0, sizeof(frame));
+	frame.AddrPC.Offset = c.Rip;
+	frame.AddrPC.Mode = AddrModeFlat;
+	frame.AddrFrame.Offset = c.Rbp;
+	frame.AddrFrame.Mode = AddrModeFlat;
+	frame.AddrStack.Offset = c.Rsp;
+	frame.AddrStack.Mode = AddrModeFlat;
+
+	for (int depth = 0; depth < 64; depth++) {
+		if (!StackWalk64(IMAGE_FILE_MACHINE_AMD64, process, thread, &frame, &c, NULL, SymFunctionTableAccess64,
+		        SymGetModuleBase64, NULL)) {
+			break;
+		}
+		DWORD64 addr = frame.AddrPC.Offset;
+		if (!addr) {
+			break;
+		}
+
+		DWORD64 base = SymGetModuleBase64(process, addr);
+		modname[0] = 0;
+		if (!base || !GetModuleFileNameA((HMODULE)(uintptr_t)base, modname, sizeof(modname))) {
+			strcpy(modname, "?");
+		}
+		if (base && base != last_base) {
+			errPrint(base, modname, DWST_BASE_ADDR, NULL, count, 0);
+			last_base = base;
+		}
+
+		memset(&sym, 0, sizeof(sym));
+		sym.info.SizeOfStruct = sizeof(SYMBOL_INFO);
+		sym.info.MaxNameLen = 255;
+		DWORD64 symdisp = 0;
+		const char *funcname = SymFromAddr(process, addr, &symdisp, &sym.info) ? sym.info.Name : NULL;
+
+		IMAGEHLP_LINE64 line;
+		DWORD linedisp = 0;
+		memset(&line, 0, sizeof(line));
+		line.SizeOfStruct = sizeof(line);
+		if (SymGetLineFromAddr64(process, addr, &linedisp, &line)) {
+			errPrint(addr, line.FileName, (int)line.LineNumber, funcname, count, 0);
+		} else if (funcname) {
+			errPrint(addr, modname, 0, funcname, count, 0);
+		} else {
+			errPrint(addr, modname, DWST_NO_DBG_SYM, NULL, count, 0);
+		}
+	}
+
+	SymCleanup(process);
+}
+#endif
+
 static LONG WINAPI exceptionPrinter(LPEXCEPTION_POINTERS ep)
 {
 	void xlog(FILE * logfp, char *format, ...);
@@ -144,7 +224,11 @@ static LONG WINAPI exceptionPrinter(LPEXCEPTION_POINTERS ep)
 	}
 
 	int count = 0;
+#ifdef _MSC_VER
+	dbghelp_print_stack(ep->ContextRecord, &count);
+#else
 	dwstOfException(ep->ContextRecord, &errPrint, &count);
+#endif
 
 	fflush(stderr);
 	fflush(errorfp);
