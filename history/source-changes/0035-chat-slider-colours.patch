+// for the chat slider: lines kept, lines shown, first shown line (0 = oldest kept)
+void render_text_scroll_info(int *avail, int *visible, int *pos)
+{
+	int oldest = textlines >= MAXTEXTLINES ? textnextline : 0;
+
+	*avail = textlines >= MAXTEXTLINES ? MAXTEXTLINES : textlines;
+	*visible = TEXTDISPLAYLINES;
+	*pos = (textdisplayline - oldest + MAXTEXTLINES) % MAXTEXTLINES;
+}
+
+void render_text_scroll_to(int pos)
+{
+	int avail, visible, cur, oldest = textlines >= MAXTEXTLINES ? textnextline : 0;
+
+	render_text_scroll_info(&avail, &visible, &cur);
+	if (avail <= visible) {
+		return;
+	}
+	if (pos > avail - visible) {
+		pos = avail - visible;
+	}
+	if (pos < 0) {
+		pos = 0;
+	}
+	textdisplayline = (oldest + pos) % MAXTEXTLINES;
+	if (!render_text_scrolled_up()) {
+		text_unseen = 0;
+	}
+}
+
