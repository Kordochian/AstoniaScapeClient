 // Scale the client would pick for the current window size after a restart
 int sdl_best_scale(void)
 {
-	int w = 0, h = 0;
+	int w = 0, h = 0, scale;
 
 	if (!sdlren || !SDL_GetRenderOutputSize(sdlren, &w, &h) || w <= 0 || h <= 0) {
 		return sdl_scale;
 	}
-	return sdl_scale_for_size(w, h);
