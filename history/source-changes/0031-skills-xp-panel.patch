+	if (skltab && sklsel2 != -1 && sklsel2 + skloff < skltab_cnt && skltab[sklsel2 + skloff].skill_id >= 0 &&
+	    skltab[sklsel2 + skloff].skill_id < MAXCSKILL) {
+		if (tick - last_tick > HOVER_DELAY) {
+			display_hover_skill_xp(&skltab[sklsel2 + skloff]);
+		}
+		return;
+	}
+
 	if (sv_ver == 35) {
 		display_hover_skill_v35();
