@@ -1512,6 +1512,7 @@ int render_char_len(char c)
 #define TEXTDISPLAYLINES (TEXTDISPLAY_SY / TEXTDISPLAY_DY)
 
 int textnextline = 0, textdisplayline = 0, textlines = 0;
+static int text_unseen = 0; // messages that arrived while the chat was scrolled up
 
 struct letter {
 	char c;
@@ -1566,6 +1567,7 @@ void render_set_textfont(int nr)
 	}
 	bzero(text, MAXTEXTLINES * MAXTEXTLETTERS * sizeof(struct letter));
 	textnextline = textdisplayline = textlines = 0;
+	text_unseen = 0;
 }
 
 /**
@@ -1734,6 +1736,10 @@ void render_add_text(char *ptr)
 		textdisplayline = (textdisplayline + 1) % MAXTEXTLINES;
 	}
 	textlines++;
+
+	if (render_text_scrolled_up()) {
+		text_unseen++;
+	}
 }
 
 int render_text_init_done(void)
@@ -1865,6 +1871,31 @@ void render_text_linedown(void)
 
 	// Move display one line down (toward newer text)
 	textdisplayline = (textdisplayline + 1) % MAXTEXTLINES;
+
+	if (!render_text_scrolled_up()) {
+		text_unseen = 0;
+	}
+}
+
+// true when the chat is not showing the newest line
+int render_text_scrolled_up(void)
+{
+	return textlines > TEXTDISPLAYLINES && (textdisplayline + TEXTDISPLAYLINES) % MAXTEXTLINES != textnextline;
+}
+
+// number of messages that arrived while scrolled up
+int render_text_unseen(void)
+{
+	return text_unseen;
+}
+
+// jump straight to the newest line
+void render_text_bottom(void)
+{
+	if (textlines > TEXTDISPLAYLINES) {
+		textdisplayline = (textnextline + MAXTEXTLINES - TEXTDISPLAYLINES) % MAXTEXTLINES;
+	}
+	text_unseen = 0;
 }
 
