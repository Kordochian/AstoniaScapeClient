+
+// Map the game's picture onto the window. If the window fits the game area at the
+// current scale and would not get a larger scale, draw pixel for pixel and center the
+// game as sdl_init() does. Otherwise scale the game area to fit the window.
+static void sdl_update_presentation(void)
+{
+	int w = 0, h = 0, gw, gh;
+	SDL_Texture *target;
+
+	if (!sdlren || !SDL_GetRenderOutputSize(sdlren, &w, &h) || w <= 0 || h <= 0) {
+		return;
+	}
+
+	gw = XRES * sdl_scale;
+	gh = YRES * sdl_scale;
+
+	target = SDL_GetRenderTarget(sdlren);
+	SDL_SetRenderTarget(sdlren, NULL);
+
+	if (w >= gw && h >= gh && sdl_scale_for_size(w, h) <= sdl_scale) {
+		SDL_SetRenderLogicalPresentation(sdlren, w, h, SDL_LOGICAL_PRESENTATION_LETTERBOX);
+		render_set_offset((w / sdl_scale - XRES) / 2, (h / sdl_scale - YRES) / 2);
+	} else {
+		SDL_SetRenderLogicalPresentation(sdlren, gw, gh, SDL_LOGICAL_PRESENTATION_LETTERBOX);
+		render_set_offset(0, 0);
+	}
