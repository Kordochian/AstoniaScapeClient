+// The input line under the chat: a box that says how to start chatting while the
+// action keys are active, and holds the typed text while chatting.
+static void cmd_box(int *sx, int *sy, int *ex, int *ey)
+{
+	*sx = dotx(DOT_TXT) - 3;
+	*sy = doty(DOT_TX2) - 4;
+	*ex = dotx(DOT_TX2) + 2;
+	*ey = doty(DOT_TX2) + 9;
+}
+
+// x, y in chat panel coordinates
+int cmd_box_hit(int x, int y)
+{
+	int sx, sy, ex, ey;
+
+	cmd_box(&sx, &sy, &ex, &ey);
+	return x >= sx && x <= ex && y >= sy && y <= ey;
+}
+
 void display_cmd(void)
 {
-	int n, x, tmp;
+	int n, x, tmp, sx, sy, ex, ey;
+
+	cmd_box(&sx, &sy, &ex, &ey);
 
 	if (!context_key_isset()) {
+		// ready: the action keys are active until the player clicks here or presses Enter
+		int hover = pnl_at(mousex, mousey) == PNL_CHAT && cmd_box_hit(pnl_mx(PNL_CHAT), pnl_my(PNL_CHAT));
+
+		render_rect_alpha(sx, sy, ex, ey, IRGB(2, 2, 2), 140);
+		gui_draw_box_outline(sx, sy, ex, ey, hover ? IRGB(26, 20, 8) : IRGB(14, 11, 6));
+		render_text((sx + ex) / 2, doty(DOT_TX2) - 1, hover ? whitecolor : graycolor, RENDER_ALIGN_CENTER,
+		    "<Click Here or Press Enter to Chat>");
 		return;
 	}
 
+	render_rect_alpha(sx, sy, ex, ey, IRGB(2, 2, 2), 140);
+	gui_draw_box_outline(sx, sy, ex, ey, context_key_enabled() ? IRGB(31, 26, 12) : IRGB(14, 11, 6));
+
 	if (cmdcursor < cmddisplay) {
 		cmddisplay = 0;
 	}
